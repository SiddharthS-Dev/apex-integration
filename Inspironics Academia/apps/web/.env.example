# Which backend the web app talks to.
#   api  (default) — the Academy API server (apps/api), same origin under /api
#   demo           — bundled in-browser demo backend; data lives in localStorage, no server needed
VITE_BACKEND=api

# Base path the API is mounted under (the client calls `${VITE_API_BASE_URL}api/...`).
# Keep it same-origin: the session is a SameSite=Lax cookie.
VITE_API_BASE_URL=/

# Dev server only: where Vite proxies /api requests.
API_PROXY_TARGET=http://localhost:4000
