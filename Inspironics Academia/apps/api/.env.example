# ---- Server ----------------------------------------------------------------
PORT=4000
# Where the web app is served (used for OAuth redirects back, reset links, CORS allowlist)
APP_ORIGIN=http://localhost:5173
# The same, path included, when the app is mounted below the origin (Apex sets it to …/academia)
APP_BASE_URL=

# ---- Storage ---------------------------------------------------------------
# Unset → SQLite via node:sqlite at SQLITE_PATH (development).
# Set   → Postgres (production), e.g. postgres://user:pass@host:5432/academy
DATABASE_URL=
# Defaults to <DATA_DIR>/academy.db
SQLITE_PATH=
DATA_DIR=data

# ---- Auth ------------------------------------------------------------------
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# This email becomes admin on registration (see ALLOW_FIRST_USER_ADMIN for the very first account)
BOOTSTRAP_ADMIN_EMAIL=
# With a password as well, that admin is created at startup — no registering needed. Apex signs in to
# every app with one account, so use the same email and password as SlidesVault and the Showcase.
# Only ever creates the account; it never changes the password of one that already exists.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
# Whether the very first self-registered account becomes admin. Default: yes in development, NO when
# NODE_ENV=production (use BOOTSTRAP_ADMIN_EMAIL/PASSWORD there). Set true only to restore the old
# behaviour on a deployment nobody else can reach before you register.
ALLOW_FIRST_USER_ADMIN=
# Consecutive failed sign-ins for one email (within 15 min) before that email is locked for 15 min.
LOGIN_MAX_FAILURES=10

# ---- Secrets at rest ------------------------------------------------------
# 32 random bytes, base64 — encrypts the Dropbox refresh token (AES-256-GCM).
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ---- AI text generation ------------------------------------------------------
# Called only from this server; keys never reach the browser. See docs/ai-studio/AI_PROVIDER_SETUP.md.
# AI_PROVIDER = gemini (default) | ollama | none. Google Gemini needs only GEMINI_API_KEY
# (create one at https://aistudio.google.com/apikey); GEMINI_MODEL defaults to gemini-3.8-flash,
# Google's recommended model for new projects (https://ai.google.dev/gemini-api/docs/models).
# AI_FALLBACK_PROVIDER is optional; leave it empty so a failed call is reported, never re-sent elsewhere.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Seconds before a Gemini request is abandoned (it is retried on rate limits and server errors).
GEMINI_TIMEOUT_SECONDS=300
# Attempts per Gemini request on rate limits / overload (503 "high demand"), with exponential backoff.
GEMINI_MAX_ATTEMPTS=5
# Course batches: wait this long and retry a lesson once when Gemini is overloaded or rate-limited.
AI_BATCH_RETRY_DELAY_SECONDS=60
# Lessons a course batch generates at the same time (1–3); keep 1 on free / low quotas.
AI_BATCH_CONCURRENCY=1
# OLLAMA_BASE_URL=http://gpu-server:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Identical AI requests are answered from the cache (an explicit regenerate asks again).
ENABLE_CONTENT_CACHE=true

# ---- Voice-over (text to speech) ---------------------------------------------
# MEDIA_PROVIDER = gemini | google | elevenlabs | piper | none.
#   gemini = Gemini speech generation with the same GEMINI_API_KEY (no Google Cloud project needed).
#   google = Google Cloud Text-to-Speech (its own API key or service account; see GOOGLE_TTS_SETUP.md).
#   none   = no recorded narration: the players read the script aloud with the browser's voice
#            (MP4 rendering needs recorded narration).
MEDIA_PROVIDER=none
# Gemini speech: model, one of its 30 prebuilt voices (e.g. Kore, Puck, Charon, Aoede) and a delivery style.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_STYLE=clear, warm and encouraging, at a steady teaching pace
# Speech has per-minute request limits: after a 429, wait this many seconds × attempt (up to 3 times).
GEMINI_TTS_RATE_LIMIT_WAIT_SECONDS=30
TTS_LANGUAGE=en-IN
TTS_VOICE=
TTS_SPEAKING_RATE=1
TTS_PITCH=0
# Google Cloud Text-to-Speech: an API key restricted to the TTS API, or a service-account key file.
GOOGLE_TTS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT_ID=
# ElevenLabs (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# Piper (optional, local)
PIPER_EXECUTABLE_PATH=
PIPER_MODEL_PATH=
# The same narration with the same voice settings is never paid for twice.
ENABLE_AUDIO_CACHE=true
MEDIA_MAX_SCENES=8

# ---- Video rendering ---------------------------------------------------------
# Template-based MP4s (slides + narration + subtitles) rendered with FFmpeg on this server.
# FFMPEG_PATH empty = the binary bundled by the ffmpeg-static package. See docs/ai-studio/VIDEO_ENGINE_SETUP.md.
VIDEO_PROVIDER=ffmpeg
FFMPEG_PATH=
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=25
# Unchanged scenes are reused when a video is rendered again.
ENABLE_SCENE_REGENERATION=true
MAX_CONCURRENT_JOBS=1

# ---- What runs without being asked ---------------------------------------------
# Paid generation is on demand by default. true restores the old automatic behaviour.
AUTO_GENERATE_AUDIO=false
SYNC_AI_EXTRACT=false
SYNC_AI_MEETINGS=false

# ---- Usage limits and prices (empty = no limit / unknown price) ----------------
# Admins can change the limits at runtime in AI Studio -> Usage & budget.
AI_DAILY_LIMIT=
AI_MONTHLY_BUDGET=
TTS_MONTHLY_CHARACTER_LIMIT=
VIDEO_MONTHLY_RENDER_LIMIT=
# Google Gemini prices are built in; set these for other providers to see estimated costs (USD).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
TTS_PRICE_PER_MILLION_CHARS=

# ---- Dropbox ---------------------------------------------------------------
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Must be registered character-for-character in the Dropbox App Console
DROPBOX_REDIRECT_URI=http://localhost:4000/api/dropbox/oauth/callback
# Default folder to sync ('' = whole Dropbox); admins can change it in /admin/integrations
DROPBOX_SYNC_ROOT=

# ---- Dropbox app for meeting transcripts (optional) ------------------------
# Give meeting transcripts their own Dropbox app (own key, secret and connection). Its redirect URI is
# DROPBOX_REDIRECT_URI with /dropbox/meetings/oauth/callback in place of /dropbox/oauth/callback
# (e.g. http://localhost:5173/academia/api/dropbox/meetings/oauth/callback) — register that on the app.
# Unset → meetings use the playbooks app above.
DROPBOX_MEETINGS_APP_KEY=
DROPBOX_MEETINGS_APP_SECRET=
DROPBOX_MEETINGS_REDIRECT_URI=

# ---- Category sources (optional) ----------------------------------------------
# A playbook category can sync from a Dropbox folder of its own (Admin -> Integrations -> Category sources).
# Give it its own Dropbox app with DROPBOX_<CATEGORY>_APP_KEY / _APP_SECRET (e.g. LEARNING, STRATEGIC);
# register its redirect URI on that app: DROPBOX_REDIRECT_URI with /dropbox/sources/<category>/oauth/callback
# in place of /dropbox/oauth/callback (e.g. http://localhost:5173/academia/api/dropbox/sources/learning/oauth/callback).
# Without keys, the category folder is read through the main app above.
DROPBOX_LEARNING_APP_KEY=
DROPBOX_LEARNING_APP_SECRET=
# Set to full when that app has Full Dropbox access (then a folder must be chosen, never the whole Dropbox).
DROPBOX_LEARNING_ACCESS=

# ---- Sync ------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=30
SYNC_ON_STARTUP=false
SYNC_CONCURRENCY=4
AUTO_EXTRACT_ON_SYNC=true
MAX_EXTRACT_MB=500
MAX_UPLOAD_MB=50

# ---- Storage optimisation (Dropbox stays the primary store) -------------------
# temporary (default): Dropbox documents are read into memory when processed or viewed and not kept
#   on this server; previews are streamed from Dropbox. permanent: keep a copy per revision (old behaviour).
DROPBOX_SOURCE_CACHE=temporary
# Working folders for renders and voice conversion. Default: <OS temp>/apex-academia.
TEMP_PROCESSING_DIR=
# Temporary folders older than this whose job is no longer running are removed (hours).
TEMP_MAX_AGE_HOURS=6
# Regenerable caches are removed after this many days unused (0 = keep). Media in use is never removed.
AI_CACHE_RETENTION_DAYS=90
TTS_CACHE_RETENTION_DAYS=180
SCENE_CACHE_RETENTION_DAYS=30
EXTRACT_CACHE_RETENTION_DAYS=90
# true = run the safe clean-up daily. false = only abandoned temp folders; the rest from AI Studio → Storage.
STORAGE_AUTO_CLEANUP=false
# Where rendered videos go: apex (this server) or dropbox (Playbooks Dropbox; needs files.content.write).
# Admins can change this in AI Studio → Storage; the setting there wins.
VIDEO_OUTPUT_DESTINATION=apex
DROPBOX_OUTPUT_FOLDER=/APEX Generated Videos
# With Dropbox output: keep the MP4 on this server too (false = stream it back from Dropbox).
VIDEO_KEEP_LOCAL_COPY=true

# ---- Email + notifications --------------------------------------------------
# log    = emails are written to the server log (default; reset links stay reachable by an operator)
# resend = Resend HTTP API (RESEND_API_KEY)
# smtp   = any SMTP server via SMTP_URL, e.g. smtps://user:pass@smtp.office365.com:465
#          (nodemailer ships with the API; it is loaded only when smtp is selected)
EMAIL_PROVIDER=log
EMAIL_FROM=Inspironics Academia <academia@example.com>
RESEND_API_KEY=
SMTP_URL=
EMAIL_MAX_ATTEMPTS=5

# ---- Daily jobs -------------------------------------------------------------
# Flashcard review reminders, certificate expiry and recertification reminders, once per UTC day
JOBS_ENABLED=true
JOBS_HOUR_UTC=3
