// LessonFeedback entity — Learner feedback on a lesson.
{
  "name": "LessonFeedback",
  "type": "object",
  "description": "Learner feedback on a lesson.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Learner user id"
    },
    "lesson_id": {
      "type": "string",
      "description": "Lesson id"
    },
    "course_id": {
      "type": "string",
      "description": "Course id"
    },
    "rating": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "description": "Rating 1-5"
    },
    "comment": {
      "type": "string",
      "description": "Feedback comment"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewed",
        "resolved"
      ],
      "description": "Triage status",
      "default": "open"
    }
  },
  "required": [
    "user_id",
    "lesson_id",
    "rating"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
