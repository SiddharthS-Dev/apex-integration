# APEX private staging: every variable deploy/staging/compose.yml reads.
#
# Do not fill this in by hand. Generate the real file (gitignored, mode 0600) with random values:
#
#   node deploy/staging/generate-secrets.mjs            -> deploy/staging/.env.staging
#
# and pass it to compose with --env-file deploy/staging/.env.staging. This example holds no values.
# Variables marked (required) stop `docker compose` with an error when missing.

# ---- Exposure ------------------------------------------------------------------------------------
# Host port of the gateway. Published on 127.0.0.1 only; nothing else is published.
APEX_STAGING_PORT=
# The URL browsers use (required). http://localhost:<APEX_STAGING_PORT> for local staging. Every
# app's origin, cookie and redirect settings derive from it. An https URL needs COOKIE_SECURE=true
# in compose.yml for the Core and the Showcase and SESSION_COOKIE_SECURE=true for SlidesVault.
APEX_PUBLIC_URL=
# Image tag for the four built images (apex-staging/<service>:<tag>). Rollback = start an older tag.
APEX_IMAGE_TAG=

# ---- Internal network (optional; defaults in compose.yml) ----------------------------------------
# The backend network has no route out. The gateway has a fixed address in it, and the apps accept
# identity assertions (and the Core service assertions) from that address only.
# APEX_STAGING_SUBNET=10.213.47.0/24
# APEX_STAGING_DYNAMIC_RANGE=10.213.47.128/25
# APEX_STAGING_GATEWAY_IP=10.213.47.10

# ---- Postgres (required) -------------------------------------------------------------------------
# Superuser password of the postgres:16 container. Used by operators for backup/restore only.
POSTGRES_PASSWORD=
# One role and one database per API (core, showcase, slidesvault), created on the first start of an
# empty volume by postgres/init-databases.sh. Changing them later does not change the roles: use
# ALTER ROLE ... PASSWORD in psql, then update this file and recreate the service.
CORE_DB_PASSWORD=
SHOWCASE_DB_PASSWORD=
SLIDESVAULT_DB_PASSWORD=

# ---- Bootstrap test admin (required) ---------------------------------------------------------------
# The one invited, adult, internal test account. Created in the Core at first start (with an
# Inspironics membership, staff and platform_admin); never re-created or reset afterwards.
# Registration is closed and no first-user admin exists. Use a non-routable address (.invalid).
BOOTSTRAP_ADMIN_EMAIL=
# At least 8 characters; generated as 32 random URL-safe characters.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ---- Encryption keys at rest (required) ------------------------------------------------------------
# 32 random bytes each. Losing one makes that app's stored Dropbox refresh token unreadable (none is
# stored in staging: Dropbox is not configured).
# Core TOKEN_ENCRYPTION_KEY (base64).
CORE_TOKEN_ENCRYPTION_KEY=
# Showcase ENCRYPTION_KEY (hex) — the Showcase refuses to start in production without it.
SHOWCASE_ENCRYPTION_KEY=
# SlidesVault DROPBOX_TOKEN_ENCRYPTION_KEY (base64) — SlidesVault refuses to start without it.
SLIDESVAULT_TOKEN_ENCRYPTION_KEY=

# ---- Identity assertion keys (required) ------------------------------------------------------------
# One store, as in apex/.identity-keys.json: {"current":"<kid>","keys":{"<kid>":{"core":"<b64>",
# "showcase":"<b64>","slidesvault":"<b64>"}}}. Rotate/prune with generate-secrets.mjs
# --rotate-identity-keys / --prune-identity-keys, then recreate every service (runbook).
# The current key id. Not secret; the smoke test uses it to forge a wrong-key assertion.
APEX_IDENTITY_KID=
# The whole store — gateway only (APEX_IDENTITY_KEYS_STORE).
APEX_IDENTITY_KEYS_STORE=
# {"<kid>":"<b64>"} for one audience, current and previous kid — each to its own service only
# (APEX_IDENTITY_KEYS there).
APEX_IDENTITY_KEYS_CORE=
APEX_IDENTITY_KEYS_SHOWCASE=
APEX_IDENTITY_KEYS_SLIDESVAULT=

# ---- Deliberately absent ---------------------------------------------------------------------------
# No Dropbox app keys, no AI keys (GEMINI_API_KEY, ANTHROPIC_API_KEY), no Google client id, no mail
# provider (the Core writes mail to its log), no ALLOW_REGISTRATION. compose.yml sets each to empty or
# off explicitly, so nothing inherited from a shell can switch an external input on.
