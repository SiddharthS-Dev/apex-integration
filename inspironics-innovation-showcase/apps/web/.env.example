# Copy to apps/web/.env.local.

# Which backend the client talks to:
#   api    the Inspironics API (Dropbox-synced catalog, server sessions) — default
#   local  the bundled demo backend: static corpus, localStorage auth, no server
VITE_BACKEND=api

# '/' = same origin (the default). In development Vite proxies /api to the API;
# in production the API serves this app, so both share one origin. Keep it '/':
# the session is a SameSite=Lax cookie, and a cross-origin API would leave the
# plate viewer's <iframe> without it.
VITE_API_BASE_URL=/
# Where the dev proxy forwards /api.
# VITE_API_PROXY_TARGET=http://localhost:4100

# Optional. With a real client ID the login/register screens render the Google
# Identity Services button. Set the same value as GOOGLE_CLIENT_ID on the API,
# which verifies the credential server-side.
VITE_GOOGLE_CLIENT_ID=

# Optional. If set, browser errors are posted to this endpoint for production
# monitoring. Leave blank to keep logging only.
VITE_ERROR_ENDPOINT=
