# Copy to apps/api/.env. Every value is optional in development.

# ---------------------------------------------------------------- server
PORT=4100
# The URL browsers reach the API at. The Dropbox redirect URI is built from it.
PUBLIC_API_URL=http://localhost:4100
# Where the web app runs. Same as PUBLIC_API_URL in production (one origin).
WEB_ORIGIN=http://localhost:5180
# NODE_ENV=production
# HOST=0.0.0.0                # interface to listen on (the Apex gateway uses 127.0.0.1)
# Behind a reverse proxy, so req.ip (rate limits, login history) is the real client.
# Same values as Express's `trust proxy`: true, a hop count, or loopback / CIDR list.
# TRUST_PROXY=loopback
# SERVE_WEB=true              # serve apps/web/dist from this process (default in production)

# -------------------------------------------------------------- storage
# Unset = SQLite at apps/api/data/app.db (Node's built-in node:sqlite).
# DATABASE_URL=postgres://user:pass@host:5432/inspironics
# 32 bytes, hex (64 chars) or base64. Encrypts the Dropbox refresh token.
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ----------------------------------------------------------------- auth
SESSION_TTL_HOURS=12
# Defaults to true when PUBLIC_API_URL is https. Production on plain http is refused
# unless PUBLIC_API_URL is localhost or this is explicitly false.
# COOKIE_SECURE=true
# No mail is sent yet. Set true (development only) to return verification/reset codes
# in the API response; an administrator's reset code is never returned. Off, codes go
# to the server log (outside production) for an administrator to relay.
# EXPOSE_DEV_CODES=false
ALLOW_REGISTRATION=true
GUEST_ENABLED=true
# Server-side verification of Google Identity Services sign-ins.
GOOGLE_CLIENT_ID=
# Creates (or promotes) this administrator at startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# -------------------------------------------------------------- dropbox
# From https://www.dropbox.com/developers/apps. In the App Console, register this
# redirect URI character-for-character:  http://localhost:4100/api/dropbox/oauth/callback
# Permissions needed: account_info.read, files.metadata.read, files.content.read
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# DROPBOX_REDIRECT_URI=http://localhost:4100/api/dropbox/oauth/callback
# Default sync folder ('' = root). An admin can change it in the app.
DROPBOX_ROOT_PATH=

# ----------------------------------------------------------------- sync
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=30
SYNC_ON_STARTUP=false
SYNC_CONCURRENCY=8
MAX_EXTRACT_MB=150

# ------------------------------------------------------------------- ai
# Titles fall back to the model, and files are classified, only when both are set.
AI_ENABLED=false
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
