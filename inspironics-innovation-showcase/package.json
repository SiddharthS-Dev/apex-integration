{
  "name": "inspironics-innovation-showcase",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @inspironics/web",
    "dev:api": "npm run dev -w @inspironics/api",
    "start": "npm run start -w @inspironics/api",
    "build": "npm run build -w @inspironics/web",
    "test": "npm test --workspaces --if-present",
    "check:env": "npm run check:env --workspaces --if-present"
  }
}
