# APEX Enterprise Onboarding application. Copy to .env (not committed) to change anything; all optional.
# The portal's own ports (5173–5176, 4173, 4175–4177) are refused for the page, and a busy port is an
# error: this app never falls back to another port.

# Where the Onboarding Assistant page is served.
ONBOARDING_PORT=5180
# The portal's Academia Core API (shared backend). It must have onboarding switched on — see the
# "Stakeholder onboarding" section of Inspironics Academia/apps/api/.env.example.
ONBOARDING_CORE_PORT=4177
# The address people open (cookies become Secure when this is https).
ONBOARDING_PUBLIC_URL=http://localhost:5180
# The portal: existing users are sent to <portal>/login; nothing here signs anyone in.
ONBOARDING_PORTAL_URL=http://localhost:5173
