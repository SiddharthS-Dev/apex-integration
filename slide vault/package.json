{
  "name": "inspironics-slidesvault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Inspironics SlidesVault — Presentation Knowledge Hub (monorepo)",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @slidesvault/api",
    "dev:web": "npm run dev --workspace @slidesvault/web",
    "build": "npm run build --workspace @slidesvault/web",
    "preview": "npm run preview --workspace @slidesvault/web",
    "start": "npm run start --workspace @slidesvault/api",
    "migrate": "npm run migrate --workspace @slidesvault/api",
    "keygen": "npm run keygen --workspace @slidesvault/api",
    "test": "npm run test --workspace @slidesvault/api",
    "test:unit": "npm run test:unit --workspace @slidesvault/api",
    "test:integration": "npm run test:integration --workspace @slidesvault/api",
    "test:e2e": "npm run test:e2e --workspace @slidesvault/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
