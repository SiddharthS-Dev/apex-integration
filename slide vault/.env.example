# Leave VITE_BASE44_APP_ID unset to run against the bundled local backend
# (seeded catalog + localStorage). Set it to a deployed Base44 app id to use
# the real entities and the serverless functions under base44/.
VITE_BASE44_APP_ID=

# Server-side secrets. These are read by the Base44 functions, never by the
# browser bundle — do not prefix them with VITE_.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_ROOT_FOLDER=/Apps/SlidesVault
DROPBOX_ACCESS_TOKEN=
