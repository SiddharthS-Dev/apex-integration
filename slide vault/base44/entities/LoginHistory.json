{
  "name": "LoginHistory",
  "type": "object",
  "description": "One record per sign-in.",
  "properties": {
    "user_id": { "type": "string" },
    "user_name": { "type": "string" },
    "email": { "type": "string" },
    "login_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["success", "failed"], "default": "success" }
  },
  "required": ["login_at"]
}
