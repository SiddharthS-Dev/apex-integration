# ---------------------------------------------------------------------------
# SlidesVault backend — environment specification
#
# Copy to .env and fill in. Nothing in this file belongs in source control:
# .env is git-ignored, and every secret here can also come from a secret
# manager, KMS or Vault instead (see docs/SECURITY.md).
# ---------------------------------------------------------------------------

# --- server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Where the browser app lives. OAuth returns the administrator here.
APP_BASE_URL=http://localhost:5173
# The public URL of this API. Must be reachable by Dropbox for the callback.
API_BASE_URL=http://localhost:4000
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Set when running behind a reverse proxy, so the real client IP is used for
# rate limiting. Values are Express "trust proxy" settings, e.g. 1 or "loopback".
# TRUST_PROXY=1

# --- database --------------------------------------------------------------
# sqlite (default, zero setup) or postgres (multi-instance deployments)
DB_DRIVER=sqlite
DB_FILE=./data/slidesvault.db
# DB_DRIVER=postgres
# DATABASE_URL=postgres://slidesvault:password@localhost:5432/slidesvault

# --- dropbox app -----------------------------------------------------------
# From https://www.dropbox.com/developers/apps — scoped app, with the scopes
# listed in docs/DEPLOYMENT.md.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Must be registered *exactly* in the Dropbox App Console under "Redirect URIs".
DROPBOX_REDIRECT_URI=http://localhost:4000/api/dropbox/oauth/callback

# AES-256-GCM key for encrypting the refresh token at rest.
# Generate with: npm run keygen      (32 bytes, base64 or hex)
DROPBOX_TOKEN_ENCRYPTION_KEY=

# --- dropbox behaviour -----------------------------------------------------
DROPBOX_SYNC_ENABLED=true
DROPBOX_SYNC_INTERVAL_MINUTES=30
DROPBOX_SYNC_ON_STARTUP=false
DROPBOX_MAX_RETRIES=5
DROPBOX_REQUEST_TIMEOUT_SECONDS=30
DROPBOX_DOWNLOAD_TIMEOUT_SECONDS=120
DROPBOX_MAX_CONCURRENT_FILES=8
# Files larger than this are indexed by metadata only — never buffered.
DROPBOX_MAX_FILE_SIZE_MB=150
DROPBOX_SUPPORTED_EXTENSIONS=pdf,pptx,ppt,html
DROPBOX_OAUTH_STATE_TTL_MINUTES=10
DROPBOX_SYNC_LOCK_TTL_MINUTES=60
# Lets administrators mint short-lived direct Dropbox links.
DROPBOX_ALLOW_ADMIN_DOWNLOAD=true
# Lets administrators rename files in Dropbox itself.
DROPBOX_ALLOW_RENAME=true

# --- google sign-in (optional) ---------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Leave GOOGLE_OAUTH_ENABLED=false and the button is hidden from the sign-in
# screen entirely, rather than shown and failing.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must be registered *exactly* under "Authorised redirect URIs" in that client.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Comma-separated email domains allowed to sign in with Google.
# Empty means no domain filter.
GOOGLE_ALLOWED_DOMAINS=

# Create an account on first Google sign-in. Off by default: Google proves who
# someone is, never that they should have access to this library. Turning it on
# REQUIRES GOOGLE_ALLOWED_DOMAINS, or the server refuses to start — otherwise
# any Google account in the world could sign in and read the catalog.
GOOGLE_AUTO_CREATE_USERS=false
GOOGLE_OAUTH_STATE_TTL_MINUTES=10

# --- sessions --------------------------------------------------------------
SESSION_COOKIE_NAME=sv_session
SESSION_TTL_HOURS=12
# Must be true in production (https only).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# --- first administrator ---------------------------------------------------
# Created on first start only, and only if the account does not already exist.
# Minimum 10 characters. Remove these once the account exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# --- AI (title resolution and classification) ------------------------------
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Vision fallback for image-only decks (Gamma, Canva, picture exports).
AI_VISION_ENABLED=true
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=60

# --- derived content cache -------------------------------------------------
OBJECT_STORE_DIR=./data/objects
OBJECT_PUBLIC_BASE=/api/assets
OBJECT_CACHE_TTL_HOURS=336

# --- retention -------------------------------------------------------------
RETENTION_SYNC_LOG_DAYS=90
RETENTION_AUDIT_LOG_DAYS=365

# --- observability and limits ----------------------------------------------
METRICS_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_ADMIN_MAX_REQUESTS=120
