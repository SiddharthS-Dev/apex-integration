# ---------------------------------------------------------------------------
# Frontend configuration.
#
# The app picks its backend from these, in this order of precedence:
#
#   1. VITE_API_BASE_URL   the SlidesVault API server (apps/api) — the
#                          enterprise Dropbox integration layer
#   2. VITE_DEMO_MODE=true the bundled local demo backend (seeded catalog in
#                          localStorage), so the app runs with no server
#
# With none of these the app shows a configuration error — it never falls back
# to the demo backend on its own.
#
# Only VITE_* variables reach the browser. Server-side secrets live in
# apps/api/.env — see apps/api/.env.example.
# ---------------------------------------------------------------------------

# --- option 1: the SlidesVault API server (recommended) --------------------
# The origin the API is served from. In production, prefer serving it under the
# same domain as the app with /api proxied to it — the session cookie is
# SameSite=Lax and cross-site cookies are increasingly blocked.
VITE_API_BASE_URL=http://localhost:4000

# --- option 2: local demo -------------------------------------------------
# Seeded demo catalog and demo accounts, entirely in the browser.
# VITE_DEMO_MODE=true

# ---------------------------------------------------------------------------
# NOTE: Dropbox credentials are NOT configured here.
#
# DROPBOX_APP_KEY, DROPBOX_APP_SECRET, the token encryption key and the
# Anthropic API key belong to the backend and must never be present in a
# frontend build — everything in this file ships to the browser.
#
# See apps/api/.env.example.
# ---------------------------------------------------------------------------
